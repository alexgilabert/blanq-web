---
import Header from '../components/Header.astro';
import esTranslations from '../i18n/es.json';
import enTranslations from '../i18n/en.json';

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'es';
const metaTr = lang === 'en' ? enTranslations : esTranslations;

// La página siempre muestra ambas versiones: la sección en español usa
// esTranslations y la sección en inglés usa enTranslations.
const es = esTranslations.terms;
const en = enTranslations.terms;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{metaTr.terms.meta_title}</title>
  <meta name="description" content={metaTr.terms.meta_description}>
  <link rel="icon" type="image/png" href="/IconoVetaPNG.png" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
      line-height: 1.7;
      color: #2c333d;
      background: #f9f9fe;
      min-height: 100vh;
      padding-top: 100px;
    }

    .container { max-width: 900px; margin: 0 auto; padding: 2rem; }

    .header { text-align: center; margin-bottom: 3rem; padding: 2rem 0; }
    .header h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: 0.5rem; color: #2c333d; }
    .header p { font-size: 1rem; color: #5f5e60; }

    .content-card {
      background: #FFFFFF; border-radius: 16px; padding: 3rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08); border: 1px solid #E9ECEF;
    }

    .section { margin-bottom: 3rem; }
    .section h2 {
      font-size: 1.75rem; font-weight: 600; margin-bottom: 1.5rem;
      color: #2c333d; border-bottom: 2px solid #E9ECEF; padding-bottom: 0.5rem;
    }
    .section p, .section li { font-size: 1rem; color: #2c333d; line-height: 1.7; }
    .section ul { margin: 1.5rem 0; padding-left: 1.5rem; }

    .highlight-box {
      background: #f9f9fe; border-left: 4px solid #007aff;
      padding: 1.5rem; margin: 2rem 0; border-radius: 0 12px 12px 0;
    }
    .highlight-box p { font-weight: 500; }

    .contact-info {
      background: #f9f9fe; padding: 2.5rem;
      border-radius: 12px; margin-top: 3rem; text-align: center;
    }
    .contact-info h3 { margin-bottom: 1rem; font-size: 1.5rem; color: #2c333d; }
    .contact-info p { font-size: 1rem; color: #5f5e60; }

    .divider { text-align: center; margin: 4rem 0; font-weight: 600; color: #007aff; }

    @media (max-width: 768px) {
      body { padding-top: 80px; }
      .container { padding: 1rem; }
      .content-card { padding: 2rem 1.5rem; }
    }
  </style>
</head>

<body>
  <Header lang={lang} />
  <div class="container">
    <!-- ESPAÑOL — siempre usa esTranslations -->
    <div class="header">
      <h1>{es.title}</h1>
      <p>{es.last_updated}</p>
    </div>

    <div class="content-card">
      <div class="section">
        <p><strong>{es.effective_date}</strong></p>
      </div>

      <div class="section">
        <h2>{es.s1_title}</h2>
        <p>{es.s1_content}</p>
      </div>

      <div class="section">
        <h2>{es.s2_title}</h2>
        <p>{es.s2_content}</p>
      </div>

      <div class="section">
        <h2>{es.s3_title}</h2>
        <p>{es.s3_content}</p>
      </div>

      <div class="section">
        <h2>{es.s4_title}</h2>
        <p>{es.s4_content}</p>
        <div class="highlight-box">
          <p>{es.s4_note}</p>
        </div>
      </div>

      <div class="section">
        <h2>{es.s5_title}</h2>
        <p>{es.s5_content}</p>
      </div>

      <div class="section">
        <h2>{es.s6_title}</h2>
        <p>{es.s6_content}</p>
      </div>

      <div class="contact-info">
        <h3>{es.help_title}</h3>
        <p>{es.help_content}</p>
      </div>
    </div>

    <div class="divider">— ENGLISH VERSION BELOW —</div>

    <!-- ENGLISH — siempre usa enTranslations -->
    <div class="header">
      <h1>{en.title}</h1>
      <p>{en.last_updated}</p>
    </div>

    <div class="content-card">
      <div class="section">
        <p><strong>{en.effective_date}</strong></p>
      </div>

      <div class="section">
        <h2>{en.s1_title}</h2>
        <p>{en.s1_content}</p>
      </div>

      <div class="section">
        <h2>{en.s2_title}</h2>
        <p>{en.s2_content}</p>
      </div>

      <div class="section">
        <h2>{en.s3_title}</h2>
        <p>{en.s3_content}</p>
      </div>

      <div class="section">
        <h2>{en.s4_title}</h2>
        <p>{en.s4_content}</p>
        <div class="highlight-box">
          <p>{en.s4_note}</p>
        </div>
      </div>

      <div class="section">
        <h2>{en.s5_title}</h2>
        <p>{en.s5_content}</p>
      </div>

      <div class="section">
        <h2>{en.s6_title}</h2>
        <p>{en.s6_content}</p>
      </div>

      <div class="contact-info">
        <h3>{en.help_title}</h3>
        <p>{en.help_content}</p>
      </div>
    </div>
  </div>
</body>
</html>
