---
import Header from '../components/Header.astro';
import esTranslations from '../i18n/es.json';
import enTranslations from '../i18n/en.json';

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'es';
const tr = lang === 'en' ? enTranslations : esTranslations;
const p = tr.privacy;
---
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{p.meta_title}</title>
    <meta name="description" content={p.meta_description}>
    <link rel="icon" type="image/png" href="/IconoVetaPNG.png" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
            line-height: 1.7;
            color: #2c333d;
            background: #f9f9fe;
            min-height: 100vh;
            padding-top: 100px;
        }

        .container { max-width: 900px; margin: 0 auto; padding: 2rem; }

        .header { text-align: center; margin-bottom: 3rem; padding: 2rem 0; }
        .header h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: 0.5rem; color: #2c333d; }
        .header p { font-size: 1rem; font-weight: 400; color: #5f5e60; }

        .content-card {
            background: #FFFFFF;
            border-radius: 16px;
            padding: 3rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            border: 1px solid #E9ECEF;
        }

        .intro {
            background: #f9f9fe;
            padding: 2rem;
            border-radius: 12px;
            margin-bottom: 3rem;
            border-left: 4px solid #007aff;
        }
        .intro p { font-size: 1.05rem; color: #2c333d; }

        .section { margin-bottom: 3rem; }
        .section h2 {
            font-size: 1.75rem; font-weight: 600; margin-bottom: 1.5rem;
            color: #2c333d; padding-bottom: 0.5rem; border-bottom: 2px solid #E9ECEF;
        }
        .section p { font-size: 1rem; margin-bottom: 1.2rem; color: #2c333d; line-height: 1.7; }
        .section ul { margin: 1.5rem 0; padding-left: 1.5rem; }
        .section li { margin-bottom: 0.8rem; font-size: 1rem; color: #2c333d; }
        .section li::marker { color: #007aff; }

        .highlight-box {
            background: #f9f9fe;
            border-left: 4px solid #007aff;
            padding: 1.5rem; margin: 2rem 0;
            border-radius: 0 12px 12px 0;
        }
        .highlight-box p { font-weight: 500; color: #2c333d; }

        .rights-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem; margin: 2rem 0;
        }
        .right-item {
            background: #f9f9fe; padding: 1.5rem;
            border-radius: 12px; border-left: 4px solid #007aff;
        }
        .right-item h4 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem; color: #2c333d; }
        .right-item p { font-size: 0.95rem; color: #5f5e60; }

        .contact-info {
            background: #f9f9fe; padding: 2.5rem;
            border-radius: 12px; margin-top: 3rem; text-align: center;
        }
        .contact-info h3 { margin-bottom: 1rem; font-size: 1.5rem; color: #2c333d; }
        .contact-info p { font-size: 1rem; color: #5f5e60; }

        .legal-note {
            background: #f9f9fe; border-left: 4px solid #007aff;
            padding: 1.5rem; margin: 2rem 0; border-radius: 0 12px 12px 0;
        }
        .legal-note p { font-weight: 500; color: #2c333d; }

        strong { color: #2c333d; }

        @media (max-width: 768px) {
            body { padding-top: 80px; }
            .container { padding: 1rem; }
            .content-card { padding: 2rem 1.5rem; border-radius: 12px; }
            .header h1 { font-size: 2rem; }
            .section h2 { font-size: 1.5rem; }
            .rights-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>

<body>
    <Header lang={lang} />
    <div class="container">
        <div class="header">
            <h1>{p.page_title}</h1>
            <p>{p.last_updated}</p>
        </div>

        <div class="content-card">
            {p.effective_date}
        </div>

        <div class="intro">
            <p set:html={"En <strong>Veta</strong> " + p.intro} />
        </div>

        <div class="section">
            <h2>{p.s1_title}</h2>
            <p>{p.s1_intro}</p>
            <ul>
                <li>{p.s1_li1}</li>
                <li>{p.s1_li2}</li>
                <li>{p.s1_li3}</li>
            </ul>
            <div class="highlight-box">
                <p>{p.s1_highlight}</p>
            </div>
        </div>

        <div class="section">
            <h2>{p.s2_title}</h2>
            <p>{p.s2_intro}</p>
            <ul>
                <li>{p.s2_li1}</li>
                <li>{p.s2_li2}</li>
                <li>{p.s2_li3}</li>
                <li>{p.s2_li4}</li>
                <li>{p.s2_li5}</li>
            </ul>
        </div>

        <div class="section">
            <h2>{p.s3_title}</h2>
            <p>{p.s3_content}</p>
        </div>

        <div class="section">
            <h2>{p.s4_title}</h2>
            <p>{p.s4_content}</p>
        </div>

        <div class="section">
            <h2>{p.s5_title}</h2>
            <p>{p.s5_intro}</p>
            <ul>
                <li>{p.s5_li1}</li>
                <li>{p.s5_li2}</li>
            </ul>
        </div>

        <div class="section">
            <h2>{p.s6_title}</h2>
            <p>{p.s6_intro}</p>
            <div class="rights-grid">
                <div class="right-item">
                    <h4>{p.s6_r1_title}</h4>
                    <p>{p.s6_r1_desc}</p>
                </div>
                <div class="right-item">
                    <h4>{p.s6_r2_title}</h4>
                    <p>{p.s6_r2_desc}</p>
                </div>
                <div class="right-item">
                    <h4>{p.s6_r3_title}</h4>
                    <p>{p.s6_r3_desc}</p>
                </div>
                <div class="right-item">
                    <h4>{p.s6_r4_title}</h4>
                    <p>{p.s6_r4_desc}</p>
                </div>
                <div class="right-item">
                    <h4>{p.s6_r5_title}</h4>
                    <p>{p.s6_r5_desc}</p>
                </div>
                <div class="right-item">
                    <h4>{p.s6_r6_title}</h4>
                    <p>{p.s6_r6_desc}</p>
                </div>
            </div>
            <p>{p.s6_contact}</p>
        </div>

        <div class="section">
            <h2>{p.s7_title}</h2>
            <p>{p.s7_content}</p>
        </div>

        <div class="section">
            <h2>{p.s8_title}</h2>
            <p>{p.s8_content}</p>
        </div>

        <div class="section">
            <h2>{p.s9_title}</h2>
            <p>{p.s9_content}</p>
        </div>

        <div class="legal-note">
            <p>{p.legal_note}</p>
        </div>

        <div class="contact-info">
            <h3>{p.help_title}</h3>
            <p>{p.help_desc}</p>
            <p><strong>{p.help_contact}</strong></p>
        </div>
    </div>
</body>
</html>
