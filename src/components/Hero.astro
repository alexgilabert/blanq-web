---
// src/components/Hero.astro
import ScrollCards from '../components/ScrollCards.jsx';
import esTranslations from '../i18n/es.json';
import enTranslations from '../i18n/en.json';

interface Props { lang?: string; }
const { lang = 'es' } = Astro.props;
const tr = lang === 'en' ? enTranslations : esTranslations;
---
<section class="pt-[100px] pb-20 lg:pt-[140px] lg:pb-32 px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

            <!-- Text Content -->
            <div class="text-center lg:text-left">
                <h1 class="text-hero-title text-text-primary mb-4">
                    {tr.hero.title}<br/>{tr.hero.title_highlight}
                </h1>
                <p class="text-hero-subtitle text-text-secondary mb-8 max-w-lg mx-auto lg:mx-0">
                    {tr.hero.subtitle}
                </p>
                <div class="flex flex-row gap-4 justify-center lg:justify-start">
                    <a
                        href="https://apps.apple.com/app/veta"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-block transition-transform hover:scale-105"
                    >
                        <img
                            src="/Download_on_the_App_Store.svg"
                            alt={tr.hero.app_store_alt}
                            class="h-12 sm:h-14"
                        >
                    </a>
                    <a
                        href="https://play.google.com/store/apps/details?id=com.veta.app"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-block transition-transform hover:scale-105"
                    >
                        <img
                            src="/Download_on_the_Google_Play.png"
                            alt={tr.hero.google_play_alt}
                            class="h-12 sm:h-14 opacity-50"
                        >
                    </a>
                </div>
            </div>

            <!-- App Screenshot -->
            <div class="flex justify-center lg:justify-end">
                <img
                    src="/CapturasWebVeta.png"
                    alt={tr.hero.app_alt}
                    class="w-full max-w-md lg:max-w-lg"
                />
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<ScrollCards client:load t={tr.features} />
